# 04_builtins.mc — Built-in functions: abs, min, max, gcd

# abs(x): absolute value
abs(-42)
abs(17)

# min(a, b, ...): minimum of one or more arguments
min(50, 12, 85, 7)
min(99)

# max(a, b, ...): maximum of one or more arguments
max(50, 12, 85, 7)
max(-10, -5, -20)

# gcd(a, b): greatest common divisor of two integers (non-negative)
gcd(48, 18)
gcd(-24, 36)
gcd(0, 5)
gcd(0, 0)
